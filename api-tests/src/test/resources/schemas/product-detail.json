{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Product detail",
  "type": "object",
  "required": ["id", "slug", "name", "description", "petType", "pricing", "images", "variants"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "petType": { "enum": ["DOG", "CAT", "BOTH"] },
    "images": { "type": "array", "minItems": 1 },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sku", "label", "pricing", "stock", "available"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sku": { "type": "string", "minLength": 1 },
          "available": { "type": "integer", "minimum": 0 },
          "pricing": {
            "type": "object",
            "required": ["price", "salePrice"],
            "properties": {
              "price": { "type": "integer", "minimum": 0 },
              "salePrice": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
