{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "API error envelope",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}
