{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Cart",
  "type": "object",
  "required": ["id", "lines", "summary"],
  "properties": {
    "id": { "type": ["string", "null"] },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "variantId", "productId", "quantity", "unitPrice", "lineTotal", "maxQuantity"],
        "properties": {
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "integer", "minimum": 0 },
          "lineTotal": { "type": "integer", "minimum": 0 },
          "maxQuantity": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["subtotal", "couponDiscount", "shipping", "total", "itemCount", "couponCode"],
      "properties": {
        "subtotal": { "type": "integer", "minimum": 0 },
        "couponDiscount": { "type": "integer", "minimum": 0 },
        "shipping": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "itemCount": { "type": "integer", "minimum": 0 },
        "couponCode": { "type": ["string", "null"] }
      }
    }
  }
}
