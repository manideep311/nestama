// NESTAMA data model. Money is integer paise; timestamps are UTC.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum PetType {
  DOG
  CAT
  BOTH
}

enum PromotionPlacement {
  HERO_CARD
  COUNTDOWN_BANNER
  CAMPAIGN
  NONE
}

enum DiscountScope {
  ALL
  CATEGORIES
  PRODUCTS
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
}

// ───────────────────────── Auth (Better Auth core tables) ─────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(CUSTOMER)
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions          Session[]
  accounts          Account[]
  addresses         Address[]
  reviews           Review[]
  cart              Cart?
  wishlistItems     WishlistItem[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
  pets              Pet[]

  @@map("users")
}

// A shopper's dog or cat. An approximate age is stored as an estimated birth date.
model Pet {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  species            PetType
  birthDate          DateTime @db.Date
  birthDateEstimated Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@map("pets")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────── Customers ─────────────────────────

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String     @default("")
  imageUrl    String
  imageAlt    String     @default("")
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  showOnHome  Boolean    @default(true)
  homeLabel   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products   Product[]
  promotions Promotion[] @relation("PromotionCategories")
  coupons    Coupon[]    @relation("CouponCategories")

  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brands")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String   @default("")
  description      String
  petType          PetType
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  /// [{ label: string, value: string }]
  specs            Json     @default("[]")
  tags             String[] @default([])
  isActive         Boolean  @default(true)
  isSample         Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  publishedAt      DateTime @default(now())
  ratingAvg        Float    @default(0)
  ratingCount      Int      @default(0)
  soldCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  promotions    Promotion[]      @relation("PromotionProducts")
  coupons       Coupon[]         @relation("CouponProducts")

  @@index([categoryId, isActive])
  @@index([petType])
  @@index([publishedAt])
  @@index([soldCount])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  label             String
  /// e.g. { "Size": "Medium", "Colour": "Sage" }
  options           Json     @default("{}")
  price             Int
  mrp               Int?
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  width     Int
  height    Int
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  title              String
  body               String
  status             ReviewStatus @default(PUBLISHED)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

// ───────────────────────── Cart & wishlist ─────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ───────────────────────── Promotions & coupons ─────────────────────────

model Promotion {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  headline        String
  subheadline     String             @default("")
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean            @default(true)
  placement       PromotionPlacement @default(NONE)
  scope           DiscountScope      @default(ALL)
  categories      Category[]         @relation("PromotionCategories")
  products        Product[]          @relation("PromotionProducts")
  couponId        String?
  coupon          Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  imageUrl        String?
  imageAlt        String?
  ctaLabel        String             @default("Shop now")
  ctaHref         String             @default("/offers")
  theme           String             @default("peach")
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Coupon {
  id           String             @id @default(cuid())
  code         String             @unique
  description  String             @default("")
  type         CouponType
  /// Percent (1–100) for PERCENT, paise for FIXED.
  value        Int
  minOrder     Int                @default(0)
  maxDiscount  Int?
  startsAt     DateTime
  endsAt       DateTime
  usageLimit   Int?
  perUserLimit Int?
  scope        DiscountScope      @default(ALL)
  categories   Category[]         @relation("CouponCategories")
  products     Product[]          @relation("CouponProducts")
  isActive     Boolean            @default(true)
  usedCount    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  promotions   Promotion[]
  redemptions  CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ───────────────────────── Orders & payments ─────────────────────────

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING_PAYMENT)
  /// Snapshot of the delivery address at the time of purchase.
  shippingAddress Json
  subtotal        Int
  promoDiscount   Int         @default(0)
  couponCode      String?
  couponDiscount  Int         @default(0)
  shipping        Int
  total           Int
  gstIncluded     Int
  gstRatePercent  Int
  placedAt        DateTime    @default(now())
  expiresAt       DateTime?
  paidAt          DateTime?
  updatedAt       DateTime    @updatedAt

  items            OrderItem[]
  events           OrderEvent[]
  payments         Payment[]
  couponRedemption CouponRedemption?

  @@index([userId, placedAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName       String
  productSlug       String
  variantLabel      String
  imageUrl          String
  unitPrice         Int
  originalUnitPrice Int
  quantity          Int
  lineTotal         Int

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Payment {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          String         @default("NESTAPAY_DEMO")
  gatewayOrderId   String         @unique
  gatewayPaymentId String?        @unique
  method           PaymentMethod?
  amount           Int
  status           PaymentStatus  @default(CREATED)
  failureReason    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@map("payments")
}

// ───────────────────────── Marketing & settings ─────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

/// Singleton row (id = 1) edited from the admin dashboard.
model StoreSettings {
  id                    Int      @id @default(1)
  announcementText      String
  freeShippingThreshold Int
  flatShippingFee       Int
  gstRatePercent        Int
  heroHeadline          String
  heroSubcopy           String
  heroImageUrl          String
  heroImageAlt          String
  popularSearches       String[] @default([])
  supportEmail          String
  supportPhone          String
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}
