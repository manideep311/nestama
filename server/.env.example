# ── Database (Supabase → Connect → "Session pooler" connection string) ──
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Server ──
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"
# Proxy hops in front of the API, so rate limits see the shopper's IP:
# 1 for local/Render/Railway alone, 2 when the browser reaches the API through Vercel's rewrite.
TRUST_PROXY=1

# ── Auth (Better Auth) ──
BETTER_AUTH_SECRET="<random 32+ chars>"
BETTER_AUTH_URL="http://localhost:3000"

# ── Demo payment gateway (HMAC secret for NestaPay demo signatures) ──
DEMO_GATEWAY_SECRET="<random 32+ chars>"

# ── Seeded admin account ──
ADMIN_EMAIL="admin@nestama.test"
ADMIN_PASSWORD="<choose a password>"

# ── Optional integrations ──
CLOUDINARY_URL=""
RESEND_API_KEY=""
EMAIL_FROM="NESTAMA <hello@nestama.test>"

# ── Storefront revalidation (same value in client/.env.local) ──
REVALIDATE_SECRET="<random 32+ chars>"
# Required in production: the storefront's proxy sends it with every request, and calls
# without it (straight to the API host) are refused, so rate limits can't be dodged.
# Same value as PROXY_SECRET on the storefront. Leave empty locally.
PROXY_SECRET=""
# Live demo protections (0 turns each off): paid orders per account per day, and how often
# stock and the seeded deals reset, in hours.
DEMO_DAILY_ORDER_LIMIT=3
DEMO_RESET_HOURS=24
# Where the API reaches the Next.js app server-to-server (defaults to CLIENT_ORIGIN)
CLIENT_INTERNAL_URL=""
